# SITE_ADDRESS is a real DNS hostname in production; :80 is CI-only.
{$SITE_ADDRESS} {
    encode zstd gzip
    @api path /api /api/*
    handle @api {
        reverse_proxy api:4000
    }
    @status path /health /ready
    handle @status {
        reverse_proxy api:4000
    }
    @assets path /assets/*
    handle @assets {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        route {
            try_files {path} /index.html
            @html path /index.html
            header @html Cache-Control "no-cache"
            file_server
        }
    }
}
