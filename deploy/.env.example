# NEVER commit deploy/.env. Replace all placeholders before production.
SITE_ADDRESS=reposcout.example.org

# Use the SAME URL-safe secret in both lines. URL-encode reserved characters.
POSTGRES_PASSWORD=REPLACE_WITH_URLSAFE_RANDOM_SECRET
DATABASE_URL=postgresql://reposcout:REPLACE_WITH_URLSAFE_RANDOM_SECRET@postgres:5432/reposcout

# Optional limited public GitHub read token; strongly recommended for ingestion.
GITHUB_TOKEN=
# Empty means no authenticated moderation reviewer until explicitly configured.
MODERATION_REVIEWERS_JSON=
