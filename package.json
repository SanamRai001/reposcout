{
  "name": "reposcout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @reposcout/web",
    "dev:api": "npm run dev -w @reposcout/api",
    "build": "npm run build -w @reposcout/web && npm run build -w @reposcout/api",
    "typecheck": "npm run typecheck -w @reposcout/web && npm run typecheck -w @reposcout/api",
    "test": "npm run test -w @reposcout/web && npm run test -w @reposcout/api",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
