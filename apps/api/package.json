{
  "name": "@reposcout/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run src/database/database.integration.test.ts",
    "test:schema": "vitest run src/repositories/repository-schema.integration.test.ts",
    "test:schema:down": "vitest run src/repositories/repository-schema-down.integration.test.ts",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --migrations-table reposcout_migrations --ignore-pattern README\\.md$ --check-order",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations --migrations-table reposcout_migrations --ignore-pattern README\\.md$",
    "db:migrate:create": "node-pg-migrate create",
    "test:persistence": "vitest run src/repositories/repository-store.integration.test.ts",
    "test:ingestion": "vitest run src/github/repository-ingestion.integration.test.ts src/github/repository-refresh.integration.test.ts --maxWorkers=1",
    "ingest:repository": "tsx src/cli/ingest-repository.ts",
    "test:catalog": "vitest run src/repositories/repository-catalog.integration.test.ts",
    "test:content": "vitest run src/github/repository-readme.integration.test.ts src/github/repository-contribution-evidence.integration.test.ts --maxWorkers=1",
    "refresh:readme": "tsx src/cli/refresh-repository-readme.ts",
    "refresh:contribution-evidence": "tsx src/cli/refresh-contribution-evidence.ts",
    "test:evaluation": "vitest run src/evaluation/jev-evaluator.test.ts src/evaluation/jev-evaluation-runner.test.ts src/evaluation/typesafe-evaluation-env.test.ts src/evaluation/typesafe-system-one-client.test.ts src/evaluation/typesafe-jev-evaluation-provider.test.ts",
    "eval:jev": "tsx src/cli/evaluate-jev-run.ts",
    "eval:jev:benchmark": "tsx src/cli/print-jev-benchmark.ts",
    "eval:jev:live": "tsx src/cli/run-live-jev-evaluation.ts",
    "test:search": "vitest run src/repositories/repository-search.integration.test.ts",
    "test:submissions": "vitest run src/submissions/repository-submission.integration.test.ts src/submissions/repository-submission-validation.integration.test.ts src/submissions/repository-submission-validation-orchestrator.integration.test.ts --maxWorkers=1",
    "validate:submissions": "tsx src/cli/validate-pending-submissions.ts"
  },
  "dependencies": {
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0"
  }
}
