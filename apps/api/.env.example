PORT=4000
NODE_ENV=development

# Reverse proxy
# Keep 0 unless the API is reachable only through a trusted reverse proxy.
# For one trusted proxy hop (for example a single cPanel/nginx proxy), set 1.
TRUST_PROXY_HOPS=0

# Public repository submission rate limit
SUBMISSION_RATE_LIMIT_WINDOW_MS=600000
SUBMISSION_RATE_LIMIT_MAX_ATTEMPTS=10
SUBMISSION_RATE_LIMIT_MAX_CLIENTS=10000

# Same repository cannot immediately re-enter the workflow after a terminal result.
# Default: 24 hours. Range: 1 minute to 30 days.
SUBMISSION_RESUBMISSION_COOLDOWN_MS=86400000

# INVALID/DUPLICATE submission rows may be pruned only after this retention period.
# Minimum 31 days keeps cleanup beyond the maximum 30-day resubmission cooldown.
SUBMISSION_TERMINAL_RETENTION_DAYS=90

# PostgreSQL
DATABASE_URL=postgresql://reposcout:reposcout@localhost:5432/reposcout
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# GitHub REST API
# Optional for public repositories, but strongly recommended outside tests/local experiments.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_MS=8000


# TypeSafe / Jev evaluation only
# Required only when running: npm run eval:jev:live -w @reposcout/api
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_REQUEST_TIMEOUT_MS=8000


# Protected moderation API
# JSON object mapping stable reviewer refs to long bearer tokens.
# Example:
# MODERATION_REVIEWERS_JSON={"maintainer:your-handle":"replace-with-a-random-32+-character-secret"}
MODERATION_REVIEWERS_JSON={}
