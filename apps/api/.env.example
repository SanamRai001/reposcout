PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://reposcout:reposcout@localhost:5432/reposcout
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# GitHub REST API
# Optional for public repositories, but strongly recommended outside tests/local experiments.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT_MS=8000
